---
import { footerLinks } from "@/data/nav.ts";

interface Props {
  variant?: "space" | "paper";
}

const { variant = "paper" } = Astro.props;
const year = new Date().getFullYear();
const isSpace = variant === "space";
---

<footer
  class:list={[
    "w-full border-t py-8",
    isSpace
      ? "border-space-fg/10 bg-transparent text-space-fg/40"
      : "border-rule bg-paper text-ink-3",
  ]}
>
  <div
    class="mx-auto flex max-w-4xl flex-col items-center gap-3 px-6 sm:flex-row sm:justify-between"
  >
    <span class="mono text-xs">
      &copy; {year} Seonglae Cho
    </span>

    <div class="flex items-center gap-4">
      {
        footerLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "mono text-xs transition-colors",
              isSpace ? "hover:text-space-fg/70" : "hover:text-ink",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
